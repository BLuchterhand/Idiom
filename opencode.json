{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "gopls": {
      "command": ["gopls"]
    }
  },
  "mcp": {
    "idiom-discovery": {
      "type": "local",
      "command": ["idiom", "mcp", "serve", "--stdio"],
      "enabled": true,
      "timeout": 30000
    }
  },
  "provider": {
    "llama-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6-35B-A3B (llama-server)"
        }
      }
    }
  },
  "model": "zai-coding-plan/glm-5.1"
}
