{
  "_comment": "Self-hosted dispatch config for idiom-on-idiom development. Adapted from config.example.json with auto_start_server flipped off (use `idiom backend start --profile qwen-pair` against .idiom/backends.json when launching local backends). Keep this tracked file portable; put machine-specific paths in an ignored config.json or another --config/IDIOM_CONFIG target.",
  "app_name": "Idiom (ds4)",
  "llama_server": {
    "kind": "llama",
    "binary": "llama-server",
    "host": "127.0.0.1",
    "port": 47786,
    "model": "models/ds4/DeepSeek-V4-Flash.gguf",
    "ctx_size": 100000,
    "log_file": "logs/ds4-server.log"
  },
  "chat": {
    "auto_start_server": false,
    "save_dir": "transcripts",
    "debug_log_dir": "logs/conversations",
    "debug_log_mode": "redacted",
    "system_prompt": "",
    "system_prompt_files": [
      "../prompts/base.md"
    ],
    "profiles_dir": "../prompts/profiles",
    "default_profiles": [
      "coding"
    ],
    "project_root": "",
    "project_prompt_files": [],
    "preset": "qwen3-coding-preserve",
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0.0,
    "presence_penalty": 0.0,
    "repetition_penalty": 1.0,
    "enable_thinking": true,
    "preserve_thinking": true,
    "max_tokens": 8192,
    "max_history": 20,
    "max_tool_steps": 0,
    "max_context_messages": 40,
    "max_context_chars": 100000,
    "max_model_calls": 40,
    "max_duration_seconds": 780,
    "request_timeout_seconds": 900,
    "server_start_timeout_seconds": 120,
    "implementation_dispatch": "plan_execute"
  },
  "route_classifier": {
    "enabled": false
  },
  "workspace": {
    "root": "",
    "cwd": "",
    "shell": "/bin/zsh",
    "command_timeout_seconds": 120,
    "max_output_bytes": 65536,
    "max_file_bytes": 65536,
    "max_directory_entries": 400,
    "enable_shell": true,
    "enable_writes": true,
    "tool_rules": {
      "read_file": [
        {
          "pattern": ".idiom/deny-read-test.txt",
          "decision": "deny"
        },
        {
          "pattern": "*",
          "decision": "allow"
        }
      ]
    },
    "allow_private_network": false
  },
  "implementer": {
    "kind": "llama",
    "binary": "llama-server",
    "host": "127.0.0.1",
    "port": 47787,
    "model": "models/ds4/DeepSeek-V4-Flash.gguf",
    "ctx_size": 100000,
    "log_file": "logs/ds4-implementer.log"
  }
}
