{
  "_comment": "Self-hosted dispatch config for idiom-on-idiom development. Adapted from the root config.json with auto_start_server flipped off (we use `idiom backend start --profile qwen-pair` against .idiom/backends.json instead) and workspace.root pinned so tools resolve correctly when invoked from any cwd.",
  "app_name": "Idiom (self-host)",
  "llama_server": {
    "kind": "mlx",
    "binary": "/Users/ben/.venv/mlx-lm/bin/mlx_lm.server",
    "host": "127.0.0.1",
    "port": 47680,
    "model": "qwen3.6-35b",
    "ctx_size": 262144,
    "log_file": "logs/mlx-server.log"
  },
  "chat": {
    "auto_start_server": false,
    "save_dir": "transcripts",
    "debug_log_dir": "logs/conversations",
    "debug_log_mode": "redacted",
    "system_prompt": "",
    "system_prompt_files": [
      "../prompts/base.md"
    ],
    "profiles_dir": "../prompts/profiles",
    "default_profiles": ["coding"],
    "project_root": "",
    "project_prompt_files": [],
    "preset": "qwen3-coding-preserve",
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0.0,
    "presence_penalty": 0.0,
    "repetition_penalty": 1.0,
    "enable_thinking": true,
    "preserve_thinking": true,
    "max_tokens": 8192,
    "max_history": 20,
    "max_tool_steps": 0,
    "max_context_messages": 40,
    "max_context_chars": 200000,
    "max_model_calls": 40,
    "max_duration_seconds": 780,
    "request_timeout_seconds": 900,
    "server_start_timeout_seconds": 240,
    "implementation_dispatch": "plan_execute"
  },
  "route_classifier": {
    "enabled": false,
    "base_url": "http://127.0.0.1:11437",
    "model": "",
    "always_on": false,
    "max_tokens": 512,
    "timeout_seconds": 20,
    "auto_start_server": false
  },
  "workspace": {
    "root": "/Users/ben/Documents/GitHub/idiom",
    "cwd": "/Users/ben/Documents/GitHub/idiom",
    "shell": "/bin/zsh",
    "command_timeout_seconds": 120,
    "max_output_bytes": 65536,
    "max_file_bytes": 65536,
    "max_directory_entries": 400,
    "enable_shell": true,
    "enable_writes": true,
    "allow_private_network": false
  }
}
