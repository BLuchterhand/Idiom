{
  "_comment": "Portable developer-preview config for this repository. This file shows a local llama.cpp-style setup with a placeholder model path. Keep real model paths, API choices, and auto-start overrides in ignored config.json files or another --config/IDIOM_CONFIG target.",
  "app_name": "Idiom",
  "llama_server": {
    "kind": "llama",
    "binary": "llama-server",
    "host": "127.0.0.1",
    "port": 8080,
    "model": "../models/local-model.gguf",
    "ctx_size": 262144,
    "threads": 0,
    "gpu_layers": 0,
    "jinja": true,
    "flash_attention": true,
    "reasoning": "auto",
    "reasoning_format": "deepseek",
    "reasoning_budget": -1,
    "log_file": "../logs/llama-server.log",
    "extra_args": []
  },
  "chat": {
    "auto_start_server": false,
    "save_dir": "../transcripts",
    "debug_log_dir": "../logs/conversations",
    "debug_log_mode": "redacted",
    "system_prompt": "",
    "system_prompt_files": [
      "../prompts/base.md"
    ],
    "profiles_dir": "../prompts/profiles",
    "default_profiles": [
      "coding"
    ],
    "project_root": "..",
    "project_prompt_files": [],
    "preset": "qwen3-coding-preserve",
    "temperature": 0.6,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0.0,
    "presence_penalty": 0.0,
    "repetition_penalty": 1.0,
    "enable_thinking": true,
    "preserve_thinking": true,
    "max_tokens": 8192,
    "max_history": 20,
    "max_tool_steps": 16,
    "max_context_messages": 40,
    "max_context_chars": 200000,
    "max_model_calls": 0,
    "max_operational_model_calls": 0,
    "max_duration_seconds": 780,
    "request_timeout_seconds": 900,
    "server_start_timeout_seconds": 240,
    "implementation_dispatch": "plan_execute"
  },
  "route_classifier": {
    "enabled": true,
    "base_url": "",
    "model": "",
    "always_on": true,
    "max_tokens": 512,
    "timeout_seconds": 20,
    "start_timeout_seconds": 120,
    "auto_start_server": false,
    "kind": "llama",
    "binary": "llama-server",
    "host": "127.0.0.1",
    "port": 11437,
    "server_model": "",
    "ctx_size": 8192,
    "threads": 0,
    "gpu_layers": 0,
    "log_file": "../logs/route-classifier.log",
    "extra_args": []
  },
  "tui": {
    "evidence_panel": true
  },
  "workspace": {
    "root": "..",
    "cwd": ".",
    "shell": "",
    "command_timeout_seconds": 120,
    "max_output_bytes": 65536,
    "max_file_bytes": 65536,
    "max_directory_entries": 400,
    "enable_shell": true,
    "enable_writes": true,
    "allow_private_network": false
  }
}
