{
  "_comment": "Portable backend examples for this repository. The default hosted profile needs only an API key env var. The local example uses a placeholder model path under ignored models/; do not commit real model weights or machine-local absolute paths.",
  "default_profile": "deepseek-v4-flash",
  "profiles": {
    "deepseek-v4-flash": {
      "_comment": "Hosted example. Set DEEPSEEK_API_KEY in the shell; no local model process is started.",
      "models": [
        {
          "alias": "deepseek-v4-flash",
          "model": "deepseek-v4-flash",
          "kind": "deepseek",
          "api_key_env": "DEEPSEEK_API_KEY",
          "reasoning_effort": "high",
          "roles": [
            "planner",
            "executor",
            "classifier"
          ]
        }
      ],
      "proxy": {
        "default_alias": "deepseek-v4-flash",
        "default_coder": "deepseek-v4-flash",
        "default_planner": "deepseek-v4-flash",
        "default_executor": "deepseek-v4-flash",
        "default_classifier": "deepseek-v4-flash"
      }
    },
    "claude-sonnet-example": {
      "_comment": "Hosted Anthropic example. Set ANTHROPIC_API_KEY in the shell; no local model process is started.",
      "models": [
        {
          "alias": "claude-sonnet",
          "model": "claude-sonnet-4-6",
          "kind": "anthropic",
          "api_key_env": "ANTHROPIC_API_KEY",
          "roles": [
            "planner",
            "executor",
            "classifier"
          ]
        }
      ],
      "proxy": {
        "default_alias": "claude-sonnet",
        "default_coder": "claude-sonnet",
        "default_planner": "claude-sonnet",
        "default_executor": "claude-sonnet",
        "default_classifier": "claude-sonnet"
      }
    },
    "local-llama-example": {
      "_comment": "Local example. Put your GGUF or local model directory under ignored models/, then update model_path. The checked-in placeholder is intentionally not a real model file.",
      "models": [
        {
          "alias": "local-coder",
          "binary": "llama-server",
          "model_path": "models/local-model.gguf",
          "host": "127.0.0.1",
          "port": 47780,
          "kind": "llama",
          "max_tokens": 8192,
          "roles": [
            "planner",
            "executor",
            "classifier"
          ]
        }
      ],
      "proxy": {
        "listen": 47680,
        "default_alias": "local-coder",
        "default_coder": "local-coder",
        "default_planner": "local-coder",
        "default_executor": "local-coder",
        "default_classifier": "local-coder"
      }
    }
  }
}
