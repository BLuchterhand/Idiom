{
  "_comment": "idiom's own backend config for self-hosted dispatch. It declares the same local Qwen lanes Colony uses while keeping idiom's existing 35B sampling defaults. qwen-pair remains the default stable stack: 35B planner/classifier plus coder executor. qwen-27b-pair is an opt-in planner/orchestrator eval stack: 27B-6bit planner/classifier plus the same coder executor. Refine uses the 35B lane with request-level --no-thinking instead of launching a duplicate 35B no-think process. `idiom backend start --profile qwen-pair` brings the default pair up; `idiom backend start --profile qwen-27b-pair` brings the 27B eval pair up. `idiom backend proxy --profile <profile>` runs the alias router on :47680.",
  "default_profile": "qwen-pair",
  "profiles": {
    "qwen-pair": {
      "models": [
        {
          "alias": "qwen3.6-35b",
          "binary": "/Users/ben/.venv/mlx-lm/bin/mlx_lm.server",
          "model_path": "/Users/ben/models/qwen3.6-35b-a3b-mlx-4bit-ud",
          "port": 47780,
          "cache_size": 4,
          "cache_bytes": 12884901888,
          "max_tokens": 8192,
          "extra_args": [
            "--temp", "0.6",
            "--top-p", "0.95",
            "--top-k", "20",
            "--chat-template-args", "{\"enable_thinking\":true,\"preserve_thinking\":true}"
          ],
          "roles": ["planner", "classifier"]
        },
        {
          "alias": "qwen3-coder-30b",
          "binary": "/Users/ben/.venv/mlx-lm/bin/mlx_lm.server",
          "model_path": "/Users/ben/models/qwen3-coder-30b-a3b-mlx-4bit-dwq",
          "port": 47781,
          "cache_size": 4,
          "cache_bytes": 12884901888,
          "max_tokens": 8192,
          "extra_args": [
            "--temp", "0.7",
            "--top-p", "0.8",
            "--top-k", "20",
            "--chat-template-args", "{\"enable_thinking\":false}"
          ],
          "roles": ["executor"]
        }
      ],
      "proxy": {
        "listen": 47680,
        "default_alias": "qwen3.6-35b",
        "default_planner": "qwen3.6-35b",
        "default_executor": "qwen3-coder-30b",
        "default_coder": "qwen3-coder-30b",
        "default_classifier": "qwen3.6-35b"
      }
    },
    "qwen-27b-pair": {
      "models": [
        {
          "alias": "qwen3.6-27b",
          "binary": "/Users/ben/.venv/mlx-lm/bin/mlx_lm.server",
          "model_path": "/Users/ben/models/qwen3.6-27b-mlx-6bit",
          "port": 47783,
          "cache_size": 4,
          "cache_bytes": 12884901888,
          "max_tokens": 8192,
          "extra_args": [
            "--temp", "0.6",
            "--top-p", "0.95",
            "--top-k", "20",
            "--chat-template-args", "{\"enable_thinking\":true,\"preserve_thinking\":true}"
          ],
          "roles": ["planner", "classifier"]
        },
        {
          "alias": "qwen3-coder-30b",
          "binary": "/Users/ben/.venv/mlx-lm/bin/mlx_lm.server",
          "model_path": "/Users/ben/models/qwen3-coder-30b-a3b-mlx-4bit-dwq",
          "port": 47781,
          "cache_size": 4,
          "cache_bytes": 12884901888,
          "max_tokens": 8192,
          "extra_args": [
            "--temp", "0.7",
            "--top-p", "0.8",
            "--top-k", "20",
            "--chat-template-args", "{\"enable_thinking\":false}"
          ],
          "roles": ["executor"]
        }
      ],
      "proxy": {
        "listen": 47680,
        "default_alias": "qwen3.6-27b",
        "default_planner": "qwen3.6-27b",
        "default_executor": "qwen3-coder-30b",
        "default_coder": "qwen3-coder-30b",
        "default_classifier": "qwen3.6-27b"
      }
    }
  }
