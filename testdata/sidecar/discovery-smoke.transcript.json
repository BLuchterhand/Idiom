{
  "schema_version": "idiom.sidecar_smoke_transcript.v1",
  "name": "discovery-profile-sidecar-smoke",
  "description": "Deterministic CLI smoke for external callers using profile-scoped sidecar recipes in a temp workspace.",
  "steps": [
    {
      "id": "context-status-report-only",
      "command": "idiom tool context_status --profile discovery --caller-id ci-script --request-id build-123 --input '{\"limit\":1}'",
      "documented_recipe": true,
      "argv": ["tool", "context_status", "--profile", "discovery", "--caller-id", "ci-script", "--request-id", "build-123", "--input", "{\"limit\":1}"],
      "exit_code": 0,
      "json": true,
      "expect_json_string": {
        "Tool": "context_status",
        "Error": "",
        "sidecar.schema_version": "idiom.tool.v1",
        "sidecar.tool": "context_status",
        "sidecar.profile": "discovery",
        "sidecar.caller.caller_id": "ci-script",
        "sidecar.caller.request_id": "build-123",
        "sidecar.contract.id": "idiom.tool.v1:context_status",
        "sidecar.contract.transport": "cli",
        "sidecar.contract.decision_authority": "runtime_contract",
        "sidecar.freshness.policy": "report_only",
        "sidecar.freshness.operation": "context_status",
        "sidecar.structured_output.indexed": "false"
      },
      "expect_json_null": ["sidecar.error"],
      "expect_json_non_empty": ["Summary", "sidecar.contract.schema_version"]
    },
    {
      "id": "discovery-tool-inventory",
      "command": "idiom tool list --profile discovery",
      "documented_recipe": true,
      "argv": ["tool", "list", "--profile", "discovery"],
      "exit_code": 0,
      "json": false,
      "stdout_includes": ["context_status", "context_query", "harness_audit"],
      "stdout_excludes": ["write_file", "append_file", "apply_patch", "shell", "context_pack"]
    },
    {
      "id": "context-index-setup",
      "command": "idiom tool context_index --input '{\"path\":\".\",\"language\":\"go\",\"mode\":\"standard\"}'",
      "argv": ["tool", "context_index", "--input", "{\"path\":\".\",\"language\":\"go\",\"mode\":\"standard\"}"],
      "exit_code": 0,
      "json": true,
      "expect_json_string": {
        "Tool": "context_index",
        "Error": "",
        "sidecar.schema_version": "idiom.tool.v1",
        "sidecar.tool": "context_index",
        "sidecar.profile": "default",
        "sidecar.contract.id": "idiom.tool.v1:context_index"
      },
      "expect_json_null": ["sidecar.error"],
      "expect_json_non_empty": [
        "Summary",
        "sidecar.structured_output.index_id",
        "sidecar.structured_output.artifact_path"
      ],
      "stdout_excludes": ["sidecar-private-body-sentinel", "sidecar-auth-retry-sentinel"]
    },
    {
      "id": "external-harness-context-query",
      "command": "idiom tool context_query --profile discovery --input '{\"query\":\"callers of runToolMainWithTelemetry\",\"resolution\":\"symbol\",\"freshness_policy\":\"report_only\",\"include_evidence\":true}'",
      "documented_recipe": true,
      "argv": ["tool", "context_query", "--profile", "discovery", "--input", "{\"query\":\"callers of runToolMainWithTelemetry\",\"resolution\":\"symbol\",\"freshness_policy\":\"report_only\",\"include_evidence\":true}"],
      "exit_code": 0,
      "json": true,
      "expect_json_string": {
        "Tool": "context_query",
        "Error": "",
        "sidecar.schema_version": "idiom.tool.v1",
        "sidecar.tool": "context_query",
        "sidecar.profile": "discovery",
        "sidecar.contract.id": "idiom.tool.v1:context_query",
        "sidecar.contract.transport": "cli",
        "sidecar.freshness.policy": "report_only",
        "sidecar.freshness.operation": "context_query",
        "sidecar.structured_output.resolution": "symbol"
      },
      "expect_json_null": ["sidecar.error"],
      "expect_json_non_empty": [
        "Summary",
        "sidecar.structured_output.index_id",
        "sidecar.structured_output.nodes",
        "sidecar.structured_output.edges"
      ],
      "stdout_includes": ["runToolMainWithTelemetry"],
      "stdout_excludes": ["sidecar-private-body-sentinel", "sidecar-auth-retry-sentinel"]
    },
    {
      "id": "local-private-context-pack",
      "command": "idiom tool context_pack --input '{\"task\":\"localize auth retry handling\",\"mode\":\"plan\",\"limit\":8}'",
      "documented_recipe": true,
      "argv": ["tool", "context_pack", "--input", "{\"task\":\"localize auth retry handling\",\"mode\":\"plan\",\"limit\":8}"],
      "exit_code": 0,
      "json": true,
      "expect_json_string": {
        "Tool": "context_pack",
        "Error": "",
        "sidecar.schema_version": "idiom.tool.v1",
        "sidecar.tool": "context_pack",
        "sidecar.profile": "default",
        "sidecar.contract.id": "idiom.tool.v1:context_pack",
        "sidecar.contract.transport": "cli",
        "sidecar.freshness.policy": "read_through",
        "sidecar.freshness.operation": "context_pack",
        "sidecar.structured_output.task": "localize auth retry handling",
        "sidecar.structured_output.mode": "plan"
      },
      "expect_json_null": ["sidecar.error"],
      "expect_json_non_empty": [
        "Summary",
        "sidecar.structured_output.pack_id",
        "sidecar.structured_output.artifact_path",
        "sidecar.structured_output.candidate_files",
        "sidecar.structured_output.candidate_symbols",
        "sidecar.structured_output.tests",
        "sidecar.structured_output.contract.schema_version"
      ],
      "stdout_includes": ["auth/retry.go"],
      "stdout_excludes": ["sidecar-private-body-sentinel", "sidecar-auth-retry-sentinel"]
    },
    {
      "id": "context-status-refresh-denied",
      "command": "idiom tool context_status --profile discovery --input '{\"refresh\":true}'",
      "documented_recipe": true,
      "argv": ["tool", "context_status", "--profile", "discovery", "--input", "{\"refresh\":true}"],
      "exit_code": 1,
      "json": true,
      "expect_json_string": {
        "Tool": "context_status",
        "sidecar.schema_version": "idiom.tool.v1",
        "sidecar.tool": "context_status",
        "sidecar.profile": "discovery",
        "sidecar.contract.id": "idiom.tool.v1:context_status",
        "sidecar.error.class": "profile_denied",
        "sidecar.error.code": "profile_denied"
      },
      "expect_json_null": ["sidecar.freshness"],
      "expect_json_non_empty": ["Error", "sidecar.error.message"],
      "stdout_includes": ["read_only_profile"]
    }
  ]
}
