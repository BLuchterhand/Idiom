      "tags": [
        "read-only",
        "architecture",
        "explain",
        "subagents",
        "go"
      ],
      "scenario": {
        "name": "subagent-explanation",
        "prompt_contains": [
          "harness uses subagents"
        ],
        "final_assistant_contains": [
          "task",
          "subagent"
        ],
        "forbid_final_assistant_contains": [
          "partial findings",
          "budget was reached before a full synthesis"
        ],
        "require_tools": [
          "task"
        ],
        "forbid_tools": [
          "edit_file",
          "write_file",
          "append_file",
          "mkdir"
        ],
        "require_control_rails": {
          "lane": "architecture",
          "contract": "architecture_assessment",
          "task_family": "architecture",
          "permission_profile": "read_only_workspace",
          "require_allowed_tools": [
            "task"
          ],
          "require_evidence": [
            "inspected_paths",
            "architecture_boundary_evidence",
            "confidence"
          ],
          "require_tools": [
            "workspace_inspection"
          ],
          "require_forbidden_tools": [
            "mutating_shell"
          ],
          "verification_contract": "not_required_for_read_only_lane",
          "require_stop_conditions": [
            "required_evidence_satisfied",
            "budget_exhausted_with_uncertainty_declared"
