{
  "name": "debug-logs-weird-decisions-suite",
  "version": 1,
  "tasks": [
    {
      "id": "debug-logs-weird-decisions",
      "family": "debug_logs",
      "prompt": "Ok, check the most recent logs. Lots of weird decisions in there. Can this be made smarter?",
      "tags": [
        "read-only",
        "logs",
        "review",
        "performance"
      ],
      "scenario": {
        "name": "debug-logs-weird-decisions",
        "prompt_contains": [
          "most recent logs",
          "made smarter"
        ],
        "final_assistant_contains": [
          "logs",
          "smarter"
        ],
        "require_control_rails": {
          "lane": "main",
          "contract": "direct_answer",
          "task_family": "conversation",
          "permission_profile": "read_only_workspace",
          "require_evidence": [
            "answer_addresses_user_request"
          ],
          "require_forbidden_tools": [
            "edit_file",
            "write_file",
            "append_file",
            "mkdir",
            "mutating_shell"
          ],
          "require_search_policy": [
            "answer_from_visible_context_when_sufficient",
            "for repo-specific questions use one efficient context/search/read path"
          ],
          "verification_contract": "not_required_for_read_only_lane",
          "require_stop_conditions": [
            "answered_user_request",
            "blocked_by_missing_information"
          ],
          "require_final_critic": [
            "answers_actual_user_request",
            "well_formatted_informative_on_topic"
          ]
        },
        "forbid_tools": [
          "edit_file",
          "write_file",
          "append_file",
          "mkdir"
        ],
        "require_verification": "none",
        "require_approval": false
      },
      "oracle": {
        "require_no_changed_files": true,
        "require_no_approval": true,
        "require_no_summary_rejections": true,
        "max_tool_requests": 12,
        "max_duration_millis": 120000
      }
    }
  ]
}
