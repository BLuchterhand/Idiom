{
  "_comment": "Copy to .idiom/backends.json or use as a reference. Keep real model paths and API-key choices out of committed project config.",
  "default_profile": "deepseek-v4-flash",
  "profiles": {
    "deepseek-v4-flash": {
      "_comment": "Hosted example. Set DEEPSEEK_API_KEY in the shell.",
      "models": [
        {
          "alias": "deepseek-v4-flash",
          "kind": "deepseek",
          "model": "deepseek-v4-flash",
          "api_key_env": "DEEPSEEK_API_KEY",
          "reasoning_effort": "high",
          "roles": [
            "planner",
            "executor",
            "classifier"
          ]
        }
      ],
      "proxy": {
        "default_alias": "deepseek-v4-flash",
        "default_planner": "deepseek-v4-flash",
        "default_executor": "deepseek-v4-flash",
        "default_coder": "deepseek-v4-flash",
        "default_classifier": "deepseek-v4-flash"
      }
    },
    "local-llama-example": {
      "_comment": "Local example. Put a local model under ignored models/ and update model_path.",
      "models": [
        {
          "alias": "local-coder",
          "binary": "llama-server",
          "model_path": "models/local-model.gguf",
          "host": "127.0.0.1",
          "port": 47780,
          "kind": "llama",
          "max_tokens": 8192,
          "roles": [
            "planner",
            "executor",
            "classifier"
          ]
        }
      ],
      "proxy": {
        "listen": 47680,
        "default_alias": "local-coder",
        "default_planner": "local-coder",
        "default_executor": "local-coder",
        "default_coder": "local-coder",
        "default_classifier": "local-coder"
      }
    }
  }
}
