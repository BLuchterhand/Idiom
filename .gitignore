# Build artifacts
bin/
/idiom
/idiom-*
/qwen-analyze
*.test
*.out
*.prof
coverage.out
desktop/dist/
desktop/node_modules/
desktop/src-tauri/target/

# Python bytecode (cmd/idiom/brief-preflight.py is the only Python file
# we ship, but pytest/import runs leave __pycache__ next to it on dev
# machines).
__pycache__/
*.pyc

# Local runtime state
.cache/
.idiom/*
!.idiom/backends.json
!.idiom/config.json
!.idiom/coding_rules.json
!.idiom/prompts/
!.idiom/prompts/**
.planning/
.book/
logs/
models/
outputs/
transcripts/
testdata/live-contracts/generated-logs/
testdata/scripted-contracts/generated-logs/
testdata/live-contracts/fixtures/**/logs/

# Local agent / IDE state
.codegraph/
.claude/
.aider*
.cursor/
.idea/
.vscode/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db

# Local config (use config.example.json as the template)
config.json
config.*.backup.json
.env
.env.local
.env.*.local

# Private book/patent workspaces live outside this repository.
.patent/

# Ephemeral review / session notes
REVIEW_*.md
NOTES_*.md
SCRATCH_*.md
docs/evidence/**/*.pid
docs/evidence/**/*.exit
docs/evidence/**/*.stderr.log
docs/evidence/**/*.tmp
docs/codebase-deadcode-signals.txt
docs/codebase-file-cleanup-tracker.csv
docs/codebase-file-cleanup-tracker.md
docs/codebase-file-inventory.txt
docs/codebase-manual-review-ledger.csv
docs/obsidian-export/

# Internal working docs (bugs, feature requests)
BUG_*.md
FEATURE_REQUEST_*.md

# Agent state
.qwen/
.reasonix/
